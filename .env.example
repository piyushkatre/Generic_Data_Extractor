# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Streamlit App Configurations
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Playwright Browser Config
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Gemini Model Configurations (Optional overrides)
GEMINI_UNDERSTANDING_MODEL=gemini-2.5-pro
GEMINI_SCHEMA_MODEL=gemini-2.5-pro
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# Developer Mode (Set to true to show Extraction Quality Reports in UI, false to hide)
DEVELOPER_MODE=false

# LLM Provider Selection (gemini, ollama)
LLM_PROVIDER=ollama

# Ollama Configuration
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434
