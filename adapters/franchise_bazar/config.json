{
  "domain": "franchisebazar.com",
  "name": "FranchiseBazar",
  "priority": 10,
  "version": "1.0.0",
  "aliases": ["franchisebazar.in", "franchisebazaar.com"],
  "metadata": {
    "description": "Custom adapter configuration for FranchiseBazar listing directories."
  },
  "extraction_rules": [
    "Always extract investment range (min/max), franchise fee, area size requirements, phone, email, and social networks.",
    "Resolve FAQ list, and put extra key-values into additional_information."
  ],
  "browser_config": {
    "scroll_strategy": {
      "max_scrolls": 15,
      "scroll_delay_ms": 1000
    },
    "wait_strategy": {
      "wait_until": "domcontentloaded",
      "timeout_ms": 30000,
      "wait_after_load_ms": 1000
    },
    "lazy_loading": {
      "enabled": true,
      "trigger_expanders": true
    },
    "content_container": null,
    "selectors_to_ignore": [".modal", ".popup", ".quick-enquiry", "#enquiryModal"]
  },
  "dom_clean_config": {
    "content_container": null,
    "allowed_tags": ["div", "p", "h1", "h2", "h3", "h4", "h5", "h6", "ul", "ol", "li", "span", "table", "tr", "td", "th", "tbody", "thead", "img", "a"],
    "removable_selectors": ["nav", "footer", "aside", "header", ".nav-tabs", ".quick-enquiry"],
    "ignored_sections": [
      "related franchise", "recommended franchise", "other franchise",
      "trending franchise", "popular franchise", "featured franchise",
      "more franchise", "you may also like", "similar franchise"
    ],
    "ignored_classes": ["navbar", "sidebar", "ads", "cookie", "modal", "popup", "lead-form"],
    "ignored_ids": ["footer", "header", "sidebar", "ads", "cookie"],
    "table_selectors": ["table"],
    "image_handling": "keep",
    "link_handling": "keep"
  },
  "clickable_tabs": {
    "selectors": [
      "a[data-toggle=\"tab\"]",
      "a[data-toggle=\"pill\"]",
      "a[role=\"tab\"]",
      "button[role=\"tab\"]",
      ".nav-tabs a",
      ".nav-tabs button",
      ".nav-pills a",
      ".tabs a",
      ".tab-link",
      ".tab-btn",
      "li.nav-item a",
      ".brand-profile-tabs a",
      ".franchise-navigation a"
    ],
    "allowed_keywords": ["profile", "business summary", "faq", "gallery", "reviews"],
    "ignored_keywords": ["email login", "social login", "login", "register", "signin", "signup"]
  },
  "dom_selectors": {
    "content_container": null
  },
  "removable_elements": {
    "remove_tag_names": ["nav", "footer", "aside", "header"],
    "remove_heading_keywords": [
      "related franchise", "recommended franchise", "other franchise",
      "trending franchise", "popular franchise", "featured franchise",
